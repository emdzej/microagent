{
  "name": "microagent",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "chat": "node packages/cli/dist/bin.js chat",
    "wizard": "node packages/cli/dist/bin.js config",
    "serve": "node packages/cli/dist/bin.js serve",
    "ui": "node packages/cli/dist/bin.js ui",
    "dev:web": "pnpm --filter @microagent/web dev",
    "ask": "node packages/cli/dist/bin.js ask",
    "dev:server": "node packages/cli/dist/bin.js serve",
    "rust:build": "cargo build --release --manifest-path rust/Cargo.toml",
    "rust:build:embed": "pnpm --filter @microagent/web build && cargo build --release --manifest-path rust/Cargo.toml -p microagent-cli --features embed-web",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path rust/Cargo.toml --all-targets -- -D warnings && cargo fmt --all --manifest-path rust/Cargo.toml --check",
    "rust:chat": "cargo run --quiet --manifest-path rust/Cargo.toml -- chat",
    "rust:ask": "cargo run --quiet --manifest-path rust/Cargo.toml -- ask",
    "rust:serve": "cargo run --quiet --manifest-path rust/Cargo.toml -- serve",
    "rust:ui": "cargo run --quiet --manifest-path rust/Cargo.toml -- ui",
    "rust:wizard": "cargo run --quiet --manifest-path rust/Cargo.toml -- config"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2"
  }
}
